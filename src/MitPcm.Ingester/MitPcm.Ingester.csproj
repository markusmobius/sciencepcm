<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestoreAdditionalProjectSources>https://www.legopds.projectratio.net/nuget/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SciencePcm.Core/SciencePcm.Core.csproj" />
    <ProjectReference Include="../CustomMcp.Ingest/CustomMcp.Ingest.csproj" />
    <PackageReference Include="BlobDataMachine" Version="1.260924.33925" ExcludeAssets="contentFiles" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>