# Prepares all three MCP services before any of them starts.
#
# Runs the three prepare steps in sequence, not in parallel: after a deallocation they
# restore their indexes from the same managed disk, and running them concurrently only
# divides each one's read bandwidth. The server units Require= this, so they wait.
#
# Each prepare is a waterfall that decides for itself - digest already current, index
# already current, restore the wiped NVMe copy, or rebuild - so this is cheap to run on
# every boot and does nothing when nothing changed.
#
# Install with tools/gcr-prep.sh, which rewrites User= and the /home/mobius paths for
# this account before copying.
#
# Check on it:
#   systemctl status mcp-prepare
#   journalctl -u mcp-prepare -f

[Unit]
Description = mcp-prepare
After = local-fs.target network.target
Before = mcp-science-server.service mcp-openalex-server.service mcp-mit-server.service

[Service]
Type=oneshot
User=mobius
RemainAfterExit=yes

WorkingDirectory=/home/mobius/sciencepcm

# Credential for the blob store the digest is pulled from. Set in the installed copy by
# tools/gcr-prep.sh, not here - editing this file would commit it. systemd starts with an
# empty environment, so a value only in your login profile is not enough. Left empty the
# pull fails and each prepare falls back to the digest already on disk.
Environment=legopds_clienthash=

# Restoring or rebuilding hundreds of GB takes far longer than the default 90 second
# start timeout.
TimeoutStartSec=0

# ExecStart lines in a oneshot unit run one after the other, which is the sequencing
# this unit exists for.
ExecStart=/bin/bash -lc 'source /home/mobius/mcp/env.sh && bash tools/sciencemcp-a100.sh prepare'
ExecStart=/bin/bash -lc 'source /home/mobius/mcp/env.sh && bash tools/openalex-a100.sh prepare'
ExecStart=/bin/bash -lc 'source /home/mobius/mcp/env.sh && bash tools/mitmcp-a100.sh prepare'

[Install]
WantedBy=multi-user.target
