# Copy indexes onto the ephemeral NVMe before any MCP server starts.
#
# /datadisk is local NVMe and is wiped when the VM deallocates. The durable copies live
# on the managed disk; this restores them. A full restore runs at the managed disk's read
# speed and grows with the index, against several hours to rebuild the OpenAlex index
# from Parquet. When the copies are already present rsync finishes in seconds, so this is
# safe to leave enabled.
#
# Install:
#   sudo cp deploy/systemd/datadisk-restore.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable datadisk-restore
#
# The MCP server units declare Requires= and After= this, so they wait for it.

[Unit]
Description = datadisk-restore
After = local-fs.target
Before = mcp-server.service openalex-server.service

[Service]
Type=oneshot
User=mobius
RemainAfterExit=yes

# Restoring hundreds of GB takes far longer than the default 90 second start timeout.
TimeoutStartSec=0

ExecStart=/home/mobius/sciencepcm/tools/datadisk-restore.sh

[Install]
WantedBy=multi-user.target
