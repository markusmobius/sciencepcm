# MCP test console, served behind nginx at https://www.mcptest.econlabs.org
#
# Modelled on the llmopenalex unit: system service, explicit User, and the dotnet in
# markusmobius's home rather than /usr/bin.
#
# Install:
#   cd ~/sciencepcm && dotnet publish src/SciencePcm.Inspector -c Release
#   sudo cp deploy/systemd/mcp-console.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mcp-console
#
# Check on it:
#   systemctl status mcp-console
#   journalctl -u mcp-console -f

[Unit]
Description = mcp-console
After = network.target

[Service]
Type=simple
User=markusmobius

WorkingDirectory=/home/markusmobius/sciencepcm/src/SciencePcm.Inspector/bin/Release/net10.0/publish
# Bound to loopback on purpose: nginx is the only thing that should reach it.
ExecStart=/home/markusmobius/dotnet/dotnet SciencePcm.Inspector.dll --urls http://localhost:6671
Restart=on-failure

[Install]
WantedBy=default.target
