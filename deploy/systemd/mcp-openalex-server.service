# OpenAlex MCP server (GPU box). Second service, same box, own port and token.
#
# mcp-prepare.service restores or rebuilds the indexes first, and runs the two services'
# prepare steps in sequence so they do not compete for the managed disk.
#
# Install:
#   cd ~/sciencepcm && bash tools/openalex-a100.sh prepare   # digest + model + index
#   sudo cp deploy/systemd/mcp-openalex-server.service /etc/systemd/system/
#   sudoedit /etc/systemd/system/mcp-openalex-server.service  # set the token
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mcp-openalex-server
#
# Check on it:
#   systemctl status mcp-openalex-server
#   journalctl -u mcp-openalex-server -f
#   curl -s localhost:8081/health
#
# Adjust User= and the /home/mobius paths if the box differs.

[Unit]
Description = mcp-openalex-server
After = network.target mcp-prepare.service
Requires = mcp-prepare.service

[Service]
Type=simple
User=mobius

WorkingDirectory=/home/mobius/sciencepcm

# Set in the installed copy under /etc/systemd/system, not here - editing this file
# would commit the token. A different value from SCIENCEPCM_TOKEN: the two endpoints
# are handed out independently.
Environment=OPENALEX_TOKEN=

# bash -lc, not ExecStart directly: env.sh exports the CUDA 12 and cuDNN 9 library
# paths ONNX Runtime needs, and it is a shell script rather than a systemd-style
# KEY=VALUE environment assignment.
ExecStart=/bin/bash -lc 'source /home/mobius/mcp/env.sh && exec bash tools/openalex-a100.sh serve'

Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
